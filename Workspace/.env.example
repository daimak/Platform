# Шаблон переменных окружения для Workspace/main.py.
# Скопируйте этот файл в Workspace/.env и подставьте реальные значения:
#   cp .env.example .env
# Workspace/.env НЕ отслеживается Git (правило ".env" в корневом .gitignore):
# секреты держим только там, никогда в коде и не в коммитах.

# Трассировка LangSmith (несекретные настройки)
export LANGCHAIN_TRACING_V2="true"
export LANGCHAIN_PROJECT="platform_evo"
export LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
export LANGSMITH_AGENT_ID="platform-evo"
export LANGSMITH_AGENT_ENVIRONMENT="local"

# Секреты (замените плейсхолдеры)
export LANGSMITH_API_KEY="lsv2_pt_ЗАМЕНИТЕ_НА_ВАШ_КЛЮЧ"          # smith.langchain.com -> Settings -> API Keys
export LANGSMITH_GATEWAY_API_KEY="lsv2_pt_ЗАМЕНИТЕ_НА_ВАШ_КЛЮЧ"  # тот же ключ или отдельный ключ шлюза
export FREE_LLM_API_KEY="freellmapi-ЗАМЕНИТЕ_НА_ВАШ_КЛЮЧ"        # ключ FreeLLMAPI (локальный шлюз :31415)
export FREE_LLM_BASE_URL="http://localhost:31415/v1"
